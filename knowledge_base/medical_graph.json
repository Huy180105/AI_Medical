    {
      "name": "Respiratory infection initial guidance",
      "type": "Guideline",
      "code": "GL-URI-001",
      "category": "guideline",
      "description": "For fever with cough, assess duration, respiratory rate, oxygen saturation, chest pain, shortness of breath, dehydration, and high risk conditions. Supportive care can include hydration, rest, fever control, and clinical follow up. Urgent evaluation is recommended for dyspnea, persistent high fever, confusion, cyanosis, severe chest pain, or oxygen saturation below local safety threshold.",
      "source": "medical_guideline.json",
      "id": "Guideline:respiratory_infection_initial_guidance"
    },
    {
      "name": "Paracetamol safety guidance",
      "type": "Guideline",
      "code": "GL-MED-001",
      "category": "guideline",
      "description": "Paracetamol can reduce fever and mild pain. Avoid duplicate acetaminophen products and review liver disease, heavy alcohol use, age, weight, pregnancy status, and total daily dose before recommending a regimen.",
      "source": "medical_guideline.json",
      "id": "Guideline:paracetamol_safety_guidance"
    },
    {
      "name": "Antibiotic stewardship",
      "type": "Guideline",
      "code": "GL-ABX-001",
      "category": "guideline",
      "description": "Antibiotics should not be recommended for uncomplicated viral upper respiratory infection. Consider bacterial infection only when clinical evidence supports it and local guideline criteria are met.",
      "source": "medical_guideline.json",
      "id": "Guideline:antibiotic_stewardship"
    }
